---
import { Seo, ThemeStyle } from '@/components/layout'
import type { Locale } from '@/data'
import '@/styles/global.css'

interface Props {
  title: string
  description: string
  locale: Locale
  /** Path without locale prefix, for canonical and hreflang. */
  path?: string
  image?: string
}

const { title, description, locale, path, image } = Astro.props
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Runs before paint: marks JS as available (see hero-initial.css) and
         keeps the browser from restoring scroll before animations set up. -->
    <script is:inline>
      document.documentElement.classList.add('js')
      history.scrollRestoration = 'manual'
    </script>
    <Seo title={title} description={description} locale={locale} path={path} image={image} />
    <ThemeStyle />
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <slot />
  </body>
</html>
