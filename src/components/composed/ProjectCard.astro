---
import { Badge } from '@/components/ui'
import type { Locale, ProjectItem } from '@/data'
import { localizedPath } from '@/lib/i18n'

interface Props {
  project: ProjectItem
  locale: Locale
  /** Accessible label for the link, e.g. content.ui.viewProject. */
  linkLabel: string
}

const { project, locale, linkLabel } = Astro.props
const title = project.title[locale]
---

<article class="group flex flex-col gap-4" data-animate="work-card">
  <a
    href={localizedPath(locale, `work/${project.slug}`)}
    class="block overflow-hidden rounded-2xl border border-border"
    aria-label={`${linkLabel}: ${title}`}
  >
    <img
      src={project.thumbnail}
      alt=""
      loading="lazy"
      decoding="async"
      class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </a>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-xl font-semibold">{title}</h3>
    <span class="text-sm text-muted">{project.year}</span>
  </div>
  <p class="text-muted">{project.description[locale]}</p>
  <ul class="flex flex-wrap gap-2">
    {project.tags.map(tag => <li><Badge label={tag} /></li>)}
  </ul>
</article>
