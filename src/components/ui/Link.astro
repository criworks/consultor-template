---
// Ported from consultant-web.
// primary   → CTA with the icon in a circle
// secondary → nav link; `active` shows a dot and sets aria-current
// tertiary  → social link; with `active` it shows a dot, without it an
//             arrow and opens in a new tab
import { ArrowDown, ArrowUpRight, Circle, type AstroComponent } from '@lucide/astro'
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  variant: 'primary' | 'secondary' | 'tertiary'
  label: string
  href: string
  active?: boolean
  icon?: AstroComponent
  iconPosition?: 'left' | 'right'
}

const { variant, label, href, active, icon, iconPosition = 'right', class: className, ...attrs } = Astro.props

const PrimaryIcon = icon ?? ArrowDown
const TertiaryIcon = icon ?? ArrowUpRight
// active provided (even as false) → dot mode; active absent → arrow mode
const tertiaryIsDotMode = active !== undefined
---

{
  variant === 'primary' && (
    <a
      href={href}
      class:list={['group flex items-center gap-4.5 rounded-link-primary transition-opacity hover:opacity-90', className]}
      {...attrs}
    >
      {iconPosition === 'left' && (
        <span class="flex h-11.75 w-13.5 shrink-0 items-center justify-center rounded-full bg-foreground p-3.5" aria-hidden="true">
          <PrimaryIcon size={24} stroke-width={2.5} class="shrink-0 text-accent-dark" />
        </span>
      )}
      <span class="text-xl font-semibold text-foreground">{label}</span>
      {iconPosition === 'right' && (
        <span class="flex h-11.75 w-13.5 shrink-0 items-center justify-center rounded-full bg-foreground p-3.5" aria-hidden="true">
          <PrimaryIcon size={24} stroke-width={2.5} class="shrink-0 text-accent-dark" />
        </span>
      )}
    </a>
  )
}

{
  variant === 'secondary' && (
    <a
      href={href}
      class:list={['flex items-center gap-2 text-base font-semibold text-foreground transition-opacity hover:opacity-80', className]}
      aria-current={active ? 'page' : undefined}
      {...attrs}
    >
      {active && <Circle size={10} fill="currentColor" stroke-width={0} class="shrink-0" aria-hidden="true" />}
      {label}
    </a>
  )
}

{
  variant === 'tertiary' && (
    <a
      href={href}
      class:list={['flex items-center gap-2 text-base font-semibold text-accent transition-opacity hover:opacity-80', className]}
      target={tertiaryIsDotMode ? undefined : '_blank'}
      rel={tertiaryIsDotMode ? undefined : 'noopener noreferrer'}
      {...attrs}
    >
      {tertiaryIsDotMode ? (
        active && <Circle size={10} fill="currentColor" stroke-width={0} class="shrink-0" aria-hidden="true" />
      ) : (
        <TertiaryIcon size={18} stroke-width={2} class="shrink-0" aria-hidden="true" />
      )}
      {label}
    </a>
  )
}
