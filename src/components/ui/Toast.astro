---
// Fixed pill announced to screen readers. Hidden until shown; the show/hide
// animation lives in lib/animations (Phase 5). One per page.
---

<div
  id="toast"
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed inset-x-0 bottom-8 z-50 mx-auto w-fit opacity-0"
>
  <div id="toast-message" class="whitespace-nowrap rounded-full bg-foreground px-4 py-2.5 text-sm font-semibold text-background">
  </div>
</div>
