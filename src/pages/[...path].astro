---
// One route for every page: the home and each profile, in every locale.
// Hero and Statement are real; the other sections are placeholders until
// Phase 6.
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import heroBg from '@/assets/images/hero-bg.webp'
import { NavDrawer, SectionHeader } from '@/components/composed'
import { Toast } from '@/components/ui'
import { content, homeSections, locales, site } from '@/config'
import type { SectionName } from '@/config'
import type { IntroMode, Locale, Profile } from '@/data'
import { projects } from '@/data'
import { localizedPath, resolveContent, selectProjects } from '@/lib'
import { profiles } from '@/profiles'
import { BaseLayout } from '@/layouts'
import { Hero, Statement } from '@/sections'

export const getStaticPaths = (() =>
  locales.flatMap(locale => [
    { params: { path: localizedPath(locale).slice(1) || undefined }, props: { locale } },
    ...profiles.map(profile => ({
      params: { path: localizedPath(locale, profile.slug).slice(1) },
      props: { locale, profile },
    })),
  ])) satisfies GetStaticPaths

interface Props {
  locale: Locale
  profile?: Profile
}

const { locale, profile } = Astro.props
const copy = resolveContent(content, locale, profile?.content)
const seo = profile?.seo[locale] ?? copy.seo
const sections: readonly SectionName[] = profile?.sections ?? homeSections
const featured = selectProjects(projects, profile?.projects)
const intro: IntroMode = profile?.intro ?? site.defaultIntro
const languages = locales
  .filter(l => l !== locale)
  .map(l => ({ label: content[l].ui.switchLanguage, href: localizedPath(l, profile?.slug), locale: l }))

// Placeholder titles for the sections built in Phase 6.
const placeholderTitles: Partial<Record<SectionName, string>> = {
  proof: copy.proof.role,
  work: copy.work.title,
  about: copy.about.title,
  contact: copy.contact.title,
}
---

<BaseLayout title={seo.title} description={seo.description} locale={locale} path={profile?.slug}>
  <!-- Fixed background: pans and blurs as the page scrolls (Hero.anim.ts).
       Eager and high priority because it is the LCP element. -->
  <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
    <Image
      src={heroBg}
      alt=""
      widths={[1800, 3600]}
      sizes="300vh"
      loading="eager"
      fetchpriority="high"
      class="block h-dvh w-auto max-w-none origin-left"
      data-animate="hero-bg"
    />
    <div class="absolute inset-0 bg-linear-to-t from-background/70 via-background/20 to-transparent"></div>
  </div>
  <div class="pointer-events-none fixed inset-0 z-10" data-animate="intro-backdrop" aria-hidden="true"></div>

  <main class="relative z-20">
    <Hero copy={copy} languages={languages} intro={intro} />
    {
      sections
        .filter(name => name !== 'hero')
        .map(name =>
          name === 'statement' ? (
            <Statement copy={copy.statement} />
          ) : (
            <section id={name} class="relative bg-background px-6 py-24 mobile:px-10">
              <SectionHeader eyebrow={name} title={placeholderTitles[name] ?? name} />
              {name === 'work' && (
                <ul class="mt-8 text-muted">
                  {featured.map(p => (
                    <li>{p.title[locale]}</li>
                  ))}
                </ul>
              )}
            </section>
          ),
        )
    }
  </main>

  <NavDrawer items={[...copy.nav, ...languages]} closeLabel={copy.ui.closeMenu} navLabel={copy.ui.mainNavigation} />
  <Toast />
</BaseLayout>
